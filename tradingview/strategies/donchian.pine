//@version=6
// NSE Donchian - TradingView Strategy Tester edition
// Mirrors "donchian" in engine.mjs: buy a 20-day high, exit on a 10-day low.

strategy("NSE Donchian (20/10)", overlay = true,
     initial_capital = 100000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.15,
     slippage = 1,
     pyramiding = 0,
     calc_on_every_tick = false,
     process_orders_on_close = false)

breakoutLen = input.int(20, "Breakout lookback", minval = 5)
exitLen     = input.int(10, "Exit lookback",     minval = 2)
startAt     = input.time(timestamp("2021-01-01"), "Backtest start")

inWindow = time >= startAt

// [1] excludes the current bar so the level is known before the breakout.
upper = ta.highest(high, breakoutLen)[1]
lower = ta.lowest(low,  exitLen)[1]

longCond = close > upper and inWindow
exitCond = close < lower

if longCond
    strategy.entry("Long", strategy.long, comment = "Donchian breakout")

if exitCond
    strategy.close("Long", comment = "Donchian exit")

plot(upper, "Upper channel", color = color.new(color.teal, 30), linewidth = 2, style = plot.style_line)
plot(lower, "Lower channel", color = color.new(color.maroon, 30), linewidth = 2, style = plot.style_line)
plotshape(longCond, "Entry", shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.tiny)
plotshape(exitCond, "Exit",  shape.triangledown, location.abovebar, color.new(color.red,   0), size = size.tiny)

alertcondition(longCond, "Donchian BUY",  "BUY {{ticker}} at {{close}} (20-day breakout)")
alertcondition(exitCond, "Donchian EXIT", "EXIT {{ticker}} at {{close}} (10-day low)")
