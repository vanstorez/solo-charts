//@version=6
// NSE EMA Trend - TradingView Strategy Tester edition
// Mirrors "ema-trend" in engine.mjs: EMA 20/50 cross with a 200-EMA regime filter.
// Paste into Pine Editor -> Add to chart -> Strategy Tester tab.

strategy("NSE EMA Trend (20/50/200)", overlay = true,
     initial_capital = 100000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.15,
     slippage = 1,
     pyramiding = 0,
     calc_on_every_tick = false,
     process_orders_on_close = false)

fastLen  = input.int(20,  "Fast EMA",  minval = 2)
slowLen  = input.int(50,  "Slow EMA",  minval = 3)
trendLen = input.int(200, "Trend EMA", minval = 20)
startAt  = input.time(timestamp("2021-01-01"), "Backtest start")

inWindow = time >= startAt

fast  = ta.ema(close, fastLen)
slow  = ta.ema(close, slowLen)
trend = ta.ema(close, trendLen)

longCond = ta.crossover(fast, slow) and close > trend and inWindow
exitCond = ta.crossunder(fast, slow)

if longCond
    strategy.entry("Long", strategy.long, comment = "EMA cross up")

if exitCond
    strategy.close("Long", comment = "EMA cross down")

plot(fast,  "EMA fast",  color = color.new(color.aqua,   0), linewidth = 2)
plot(slow,  "EMA slow",  color = color.new(color.orange, 0), linewidth = 2)
plot(trend, "EMA 200",   color = color.new(color.gray,   0), linewidth = 1)
plotshape(longCond, "Entry", shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.tiny)
plotshape(exitCond, "Exit",  shape.triangledown, location.abovebar, color.new(color.red,   0), size = size.tiny)

alertcondition(longCond, "EMA Trend BUY",  "BUY {{ticker}} at {{close}}")
alertcondition(exitCond, "EMA Trend EXIT", "EXIT {{ticker}} at {{close}}")
