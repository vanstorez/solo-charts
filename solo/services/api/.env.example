SOLO_APP_ENV=development
SOLO_API_HOST=127.0.0.1
SOLO_API_PORT=8000
SOLO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SOLO_DATABASE_PATH=data/solo.db
SOLO_HTTP_TIMEOUT_SECONDS=18

# Public prediction-market access. Live order execution is not implemented.
SOLO_POLYMARKET_ENABLED=true
SOLO_POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
SOLO_POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Licensed Global Datafeeds REST feed (optional, read-only, personal local display).
# The endpoint and access key are supplied by Global Datafeeds after subscription.
# Leave blank to run entirely on the public delayed/unknown feeds.
# Never commit the real key. Keep this file at solo/services/api/.env.
SOLO_GDF_ENABLED=true
SOLO_GDF_BASE_URL=
SOLO_GDF_API_KEY=
SOLO_GDF_REQUEST_TIMEOUT_SECONDS=8
SOLO_GDF_QUOTE_TTL_SECONDS=3
SOLO_GDF_HISTORY_TTL_SECONDS=20
SOLO_GDF_ENTITLEMENT_TTL_SECONDS=300
SOLO_GDF_HISTORY_MAX=1000

# Paper trading only. This flag is intentionally hard-disabled in the code path.
SOLO_LIVE_EXECUTION_ENABLED=false
SOLO_MAX_OPEN_POSITIONS=5
SOLO_MAX_TRADE_NOTIONAL=200000
SOLO_MAX_TOTAL_EXPOSURE=500000
SOLO_DAILY_LOSS_LIMIT=5000
SOLO_MAX_DRAWDOWN=25000
SOLO_PAPER_SLIPPAGE_BPS=5
SOLO_PAPER_FEE_BPS=2
